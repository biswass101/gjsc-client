# Backend API URL (cPanel production or local dev)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# OAuth Client Identifiers
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Optional OAuth scope overrides
# Google defaults to: openid email profile https://www.googleapis.com/auth/user.addresses.read
# NEXT_PUBLIC_GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/user.addresses.read
# Facebook defaults to: email,public_profile (add user_location once enabled under Meta App Review)
# NEXT_PUBLIC_FACEBOOK_OAUTH_SCOPES=email,public_profile,user_location

